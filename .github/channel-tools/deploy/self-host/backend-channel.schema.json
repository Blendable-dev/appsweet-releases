{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsweet.app/schemas/backend-channel-v2.json",
  "title": "AppSweet backend build channel membership",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "channel",
    "version",
    "tag",
    "publishedAt",
    "releaseReadiness",
    "deploymentDefinitionSha256",
    "releaseManifest",
    "signingKeyId",
    "revocations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "channel": {
      "enum": [
        "alpha",
        "beta"
      ]
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "tag": {
      "type": "string",
      "pattern": "^backend-v[0-9]+\\.[0-9]+\\.[0-9]+-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*$"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "releaseReadiness": {
      "const": "self-host-candidate"
    },
    "deploymentDefinitionSha256": {
      "$ref": "#/$defs/sha256"
    },
    "releaseManifest": {
      "$ref": "#/$defs/releaseManifest"
    },
    "signingKeyId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "revocations": {
      "$ref": "#/$defs/revocations"
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-build\\.[1-9][0-9]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "releaseManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/Blendable-dev/appsweet-releases/releases/download/backend-v[0-9]+\\.[0-9]+\\.[0-9]+-build\\.[1-9][0-9]*/release\\.json$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "revocations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://releases\\.appsweet\\.app/(?:acceptance/[a-f0-9]{32}/)?releases/revoked-key-ids\\.txt$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
